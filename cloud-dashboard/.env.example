PORT=5000

# WAJIB diisi sebelum deploy ke production — samain nilainya dengan
# CLOUD_SYNC_API_KEY di file .env SETIAP toko yang lapor kesini.
# Generate string acak yang panjang, contoh: openssl rand -hex 32
SYNC_API_KEY=

# JWT secret buat login owner. Kalau dikosongkan, di-generate otomatis
# tiap restart (artinya semua orang ke-logout tiap kali server restart).
# WAJIB diisi manual sebelum production.
JWT_SECRET=
